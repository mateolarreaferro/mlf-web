# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# the class repository (its own git repo); public/agents is its published copy,
# made by `npm run sync:agents`
/agents2026-mateo/

# projects hosted on this site, each its own git repo; public/<slug> and
# python/<slug>/src are their published copies, made by `npm run sync:demos`
/hosted/

# Python knowledge-graph runtime caches
__pycache__/

# Claude Code local settings (per machine)
.claude/settings.local.json
